items.PortalKey_Windsurf_Valley.name = Fragment: Orbis — Dolina Wietrznych Jeźdźców
items.PortalKey_Windsurf_Valley.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Feran ceni wolność ponad wszystko, a nigdzie nie znajduje ona pełniejszego wyrazu niż w wiatrach Doliny Wietrznych Jeźdźców.</i>
items.PortalKey_Jungles.name = Fragment: Orbis — Schronienie Tal'Kesi
items.PortalKey_Jungles.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Głęboko pod jałowymi pustkowiami pozostawionymi przez starożytną cywilizację rozkwita pierwotna oaza.</i>
items.PortalKey_Taiga.name = Fragment: Orbis — Gęstwina Smoczej Iglicy
items.PortalKey_Taiga.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Istnieją skute lodem lasy, do których nie odważy się wkroczyć nawet Wędrowiec, choćby nie wiadomo jak nęciły go dobiegające stamtąd szepty.</i>
items.PortalKey_Hederas_Lair.name = Fragment: Orbis — Złowroga Przeprawa
items.PortalKey_Hederas_Lair.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Niewielu zaznało grozy czającej się w mrocznych głębinach Orbisu.</i>
items.PortalKey_Henges.name = Fragment: Orbis — Milczące Kręgi
items.PortalKey_Henges.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Tajemnicze kamienne kręgi górują nad skutej lodem krainą.</i>
items.Portal_Device.name = Starożytna brama
items.Portal_Device.description = Umieść ją w swojej bazie, aby przełamać bariery i podróżować do innych Fragmentów!<i>\nPrace w toku.\n\nChoć klątwa więzi Orbis Gai w zamknięciu, istnieją sposoby, by przebić się przez osłaniającą go Pustkę.</i>
items.PortalKey_Goblin_Breach.name = Fragment: Orbis — Gasnące Rozpadliny
items.PortalKey_Goblin_Breach.description = <msg key="server.items.PortalKey.usage"/>\n\n<i>W ruinach zaginionej osady Rozpalonych budzi się chaos.</i>
items.PortalKey_The_Deepworks.name = Fragment: Orbis — Głębokie Warsztaty
items.PortalKey_The_Deepworks.description = <msg key="server.items.PortalKey.usage"/>\n\n<i>Głębokie Warsztaty od dawna są siedzibą najwybitniejszych goblińskich umysłów, a ich wynalazki wypełniają sale kakofonią dźwięków, odkąd najstarsi gobliny sięgają pamięcią. Chaos i katastrofa nigdy nie są daleko.</i>
