memories.general.chestActive.level1.rewards = \nMożesz wytworzyć:\n• +3 dekoracyjne skrzynie (warsztat meblarski)\n• +2 Wieczne Nasiona (warsztat rolniczy)\n\nPrace w toku
memories.general.chestActive.level2.rewards = \nMożesz wytworzyć:\n• +3 dekoracyjne skrzynie (warsztat meblarski)\n• +4 Wieczne Nasiona (warsztat rolniczy)\n\n+1 maksymalny limit teleportów\n\nPrace w toku
memories.general.chestActive.level3.rewards = \nMożesz wytworzyć:\n• Mikstury przemiany (warsztat alchemiczny)\n• +3 dekoracyjne skrzynie (warsztat meblarski)\n• +4 Wieczne Nasiona (warsztat rolniczy)\n\n+1 maksymalny limit teleportów\n\nPrace w toku
memories.general.chestActive.level4.rewards = \nMożesz wytworzyć:\n• Starożytną Bramę (warsztat arkanisty)\n• Fragmenty portalu (warsztat arkanisty)\n• +3 dekoracyjne skrzynie (warsztat meblarski)\n• +2 Wieczne Nasiona (warsztat rolniczy)\n\n+2 maksymalny limit teleportów\n\nPrace w toku
