items.Ingredient_Hide_Storm.description = Można ją przetworzyć na <item is="Ingredient_Leather_Storm"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Leather_Dark.name = Ciemna skóra wyprawiona
items.Ingredient_Leather_Heavy.name = Gruba skóra wyprawiona
items.Ingredient_Leather_Heavy.description = Wyprawiona ze skór potężnych drapieżników.\n\n<i>Każdy łowca marzy o pokonaniu stworzeń, o których mówi się jedynie w legendach. Poza nielicznymi, którzy zjednoczyli siły w epoce bohaterów, większość musi zadowolić się niedźwiedziami, wilkami i innymi potężnymi drapieżnikami.</i>
items.Ingredient_Leather_Light.name = Lekka skóra wyprawiona
items.Ingredient_Leather_Light.description = Wyprawiona ze skór pospolitych zwierząt łownych spotykanych na dzikich terenach.
items.Ingredient_Leather_Medium.name = Średniej grubości skóra wyprawiona
items.Ingredient_Leather_Medium.description = Wyprawiona z wytrzymałych skór średniej wielkości drapieżników i opancerzonych bestii.
items.Ingredient_Leather_Prismic.name = Pryzmatyczna skóra wyprawiona
items.Ingredient_Leather_Scaled.name = Łuskowata skóra wyprawiona
items.Ingredient_Leather_Soft.name = Miękka skóra wyprawiona
items.Ingredient_Leather_Storm.name = Burzowa skóra wyprawiona
items.Ingredient_Motes_Light.name = Iskierki światła
items.Ingredient_Poop.name = Kupa
items.Ingredient_Powder_Boom.name = Wybuchowy proszek
items.Ingredient_Powder_Boom.description = <i>To cenne źródło chaosu, szczególnie cenione przez mniej ostrożne gobliny, kryje w małym woreczku wybuchową moc, która przeczy jego rozmiarom. Wytwarzanie go wymaga wielkiej ostrożności — nawet najwybitniejszy gobliński wynalazca nosi blizny po nieudanym eksperymencie z wybuchowym grzybem.</i>
items.Ingredient_Fire_Essence.name = Esencja ognia
items.Ingredient_Fire_Essence.description = <i>Ta energia niegdyś nadawała kształt marzeniom rzemieślników z Tyglu. Dziś pozostaje jedynie w stworzeniach zamieszkujących spustoszone regiony wulkaniczne.</i>
items.Ingredient_Ice_Essence.name = Esencja lodu
items.Ingredient_Ice_Essence.description = <i>Gdy Wędrowcy odrzucili płomień i odłączyli się od swoich pobratymców, zwrócili się ku chłodniejszym regionom i kruchej sile rozrastających się pokryw lodowych.</i>
items.Ingredient_Life_Essence.name = Esencja życia
items.Ingredient_Life_Essence.description = <i>Forma obfitej energii życiowej, występująca w dużych ilościach w pobliżu roślin na Orbis. Być może w odpowiednio wysokim stężeniu potrafiłaby obudzić świadomość tam, gdzie wcześniej jej nie było.</i>
items.Ingredient_Life_Essence_Concentrated.name = Większa esencja życia
items.Ingredient_Life_Essence_Concentrated.description = Połączenie odpowiadające <color is="#3e9049">100 esencjom życia</color>.
items.Ingredient_Lightning_Essence.name = Esencja błyskawic
items.Ingredient_Lightning_Essence.description = <i>Szalejące burze od wieków przyciągają rozmaite stworzenia. Choć prawdziwego źródła tej magii nie sposób odnaleźć, żywiołaki zrodzone z jej pozostałości wciąż wędrują po tych ziemiach.</i>
items.Ingredient_Void_Essence.name = Esencja Pustki
items.Ingredient_Void_Essence.description = <i>Nie wiadomo, czy stworzenia Pustki wytwarzają tę esencję, czy też jest ona niezbędna do podtrzymania ich istnienia. Jedno jest pewne: są ze sobą nierozerwalnie związane.</i>
items.Ingredient_Water_Essence.name = Esencja wody
items.Ingredient_Water_Essence.description = <i>Nawet ryby mają naturalne powinowactwo z magią. Gdy woda przepływa przez ich skrzela, jej stężenie wzrasta. Być może właśnie w tym tkwi sekret otchłannych stworzeń czających się w najciemniejszych głębinach Orbis.</i>
items.Ingredient_Sinue_Cindersinue.name = Popiołowe ścięgno
items.Ingredient_Stick.name = Patyk
items.Ingredient_Strap_Leather.name = Skórzany pasek
items.Ingredient_Stud_Iron.name = Żelazny nit
items.Ingredient_Tree_Bark.name = Kora drzewa
items.Ingredient_Tree_Sap.name = Żywica drzewa
items.Ingredient_Fishbone.name = Ość
items.Kweebec_Ancient.name = Starożytny kweebec
items.Lore_Note_Died_Improperly.name = Ci, którzy nie umarli jak należy
items.Lore_Note_Died_Improperly.description = Ten podarty fragment goblińskiego tekstu wygląda na stosunkowo nowy.\n\
\n\
<i>Ci, którzy nie umarli jak należy\n\
\n\
Uważaj na Próżnego. Próbuje wypaczyć nas na swoje podobieństwo.\n\
Uważaj na Małą. Jej maszyny zawstydzają nasze.\n\
Uważaj na Silnego. Śmieje się, gdy wszystko wokół się rozpada.\n\
Uważaj na Spowitego —</i>
items.Lore_Note_Enkindled_Journal_Vermin.name = Stary dziennik Rozpalonych: Szkodniki
items.Lore_Note_Enkindled_Journal_Vermin.description = <i>Słyszę ich tam na dole. Każdego. Dnia.\n\
\n\
To brzęczenie i szczęk nigdy nie ustają.\n\
\n\
Co to jest? Szczury? Muszą być większe.\n\
\n\
Mam nadzieję, że to nie pająki.\n\
\n\
Strażnicy mieli zejść na dół, ale od wczoraj panuje wśród nich zamęt, odkąd przybył posłaniec z Tygla. Chodziło o radcę i Scaraki — nie dosłyszałem dokładnie.\n\
\n\
Mam tylko nadzieję, że wkrótce coś z tym zrobią.</i>
items.Lore_Note_Enkindled_Journal_Rite.name = Stary dziennik Rozpalonych: Rytuał
items.Lore_Note_Enkindled_Journal_Rite.description = <i>Może powinienem był pójść z nimi. Od czasu wojny drogi nie są bezpieczne.\n\
\n\
Ale ktoś musi pozostać na miejscu, by pełnić wartę, a nas zostało tak niewielu. Skoro wszyscy wyruszyli, by powstrzymać Wędrowców, któż może powiedzieć, kiedy Trorkowie nabiorą dość odwagi, by zaatakować.\n\
\n\
Ach, jak bardzo chciałem tam być i ujrzeć jej Rytuał Rozpalenia.</i>
items.Lore_Note_Enkindled_Research_Gateways.name = Podarty raport badawczy Rozpalonych: Dziwne portale
items.Lore_Note_Enkindled_Research_Gateways.description = Zachowało się tylko kilka krótkich fragmentów czegoś, co wygląda na stary dziennik badawczy.\n\
\n\
<i>...starożytne ruiny zawierające symbole, których wcześniej nie widzieliśmy...\n\
\n\
...jakaś wielka brama. W archiwach nie ma o niej żadnych informacji, ale nasze badania sugerują, że przy użyciu katalizatora może przenosić użytkownika w inne miejsce.</i>\n\
\n\
Na dole ktoś dopisał dodatkową notatkę goblińskim pismem:\n\
\n\
<i>Mam ją! Złomiarze zabiorą ją z powrotem do Głębokich Warsztatów.</i>
items.Lore_Note_Enkindled_Letter_Workshops.name = List Rozpalonych: Warsztaty wojny
items.Lore_Note_Enkindled_Letter_Workshops.description = Zachował się jedynie niewielki skrawek tego zwęglonego listu.\n\
\n\
<i>...mówili, że w ogóle nie powinniśmy tego budować. Powinniśmy skupić się na magii, nie na technologii. Magia jest czysta. Gdy połączysz ją z mechanizmem, zostaje skalana. Tak mawiał pewien stary, mądry mędrzec.\n\
\n\
Te proste słowa od tak dawna przysparzają nam kłopotów.\n\
\n\
A teraz mówią, że powinniśmy zbudować to na potrzeby wojny. Ja nie...</i>
items.Lore_Note_Enkindled_Ledger_Trade.name = Księga handlowa Rozpalonych
items.Lore_Note_Enkindled_Ledger_Trade.description = Na marginesie tej księgi nabazgrano krótką notatkę.\n\
\n\
<i>Zapamiętaj: nigdy więcej nie oferuj kweebekom pociętego drewna. Latami zdobywałem ich zaufanie i nie pozwolę, byś zaprzepaścił je przez stertę drewna.</i>
items.Lore_Note_Goblin_Commission_Abandoned_Parts.name = Goblińskie zlecenie: Porzucone części
items.Lore_Note_Goblin_Commission_Abandoned_Parts.description = <i>Jest w Głębokich Warsztatach. Za wielkim mostem.\n\
\n\
Ciężkie. Wielkie.\n\
\n\
Nie całe — tylko rdzeń.\n\
\n\
Rozbij, jeśli musisz.\n\
\n\
Może łatwiej będzie zbudować to ponownie ze złomu.</i>
items.Lore_Note_Goblin_Musings_Too_Heavy.name = Goblińskie rozważania: Za ciężkie
items.Lore_Note_Goblin_Musings_Too_Heavy.description = <i>Za ciężkie, by to przenieść.\n\
\n\
Hmm. Może mniej metalu?\n\
\n\
Piły też nie są potrzebne.\n\
\n\
Nadal się nie mieści, ale mogą tam czyhać niebezpieczeństwa.\n\
\n\
Nie da się powiększyć bramy. Przynajmniej na razie.\n\
\n\
Trzeba to zostawić. Może i tak da się bezpiecznie przejść.</i>
items.Lore_Note_Goblin_Musings_Translocation.name = Goblińskie rozważania: Magiczne przenoszenie
items.Lore_Note_Goblin_Musings_Translocation.description = <i>Pierwsza próba nieudana. Brak śladów obiektu testowego. Potrzebny nowy obiekt.\n\
\n\
Druga próba nieudana. Obiekt testowy zostawił nogi, gdy brama się zamknęła. Potrzebny nowy obiekt.\n\
\n\
Trzecia próba częściowo udana. Obiekt został przeniesiony w całości, ale znalazł się zbyt wysoko. Potrzebny nowy obiekt.\n\
\n\
Czwarta próba częściowo udana. Głos obiektu testowego zdaje się dobiegać z wnętrza litej ściany. Być może potrzebny nowy obiekt.\n\
\n\
Piąta próba udana! Obiekt wrócił w jednym kawałku. Konieczne dalsze testy.</i>
items.Lore_Note_Goblin_Poem.name = Gobliński wiersz
items.Lore_Note_Goblin_Poem.description = Ten podarty pergamin wygląda na liczący kilka stuleci, ale zapisany na nim tekst jest współczesny. Nawet dzięki Wnikliwości twojego Awatara znaczenie tych słów pozostaje niejasne. Być może miała to być sztuka.\n\
\n\
<i>Nasz cel\n\
\n\
Rozpaleni odeszli\n\
w płomieniach,\n\
zapomniane żary.\n\
\n\
Nasze wielkie, wielkie zadanie —\n\
\n\
czy oni mogą się stać?\n\
Tylko — jak</i>
items.Lore_Note_Goblin_Feastmaster_Menu.name = Menu dnia Mistrza Uczt
items.Lore_Note_Goblin_Feastmaster_Menu.description = <i>Pierwsze: Zupa z opiłków żelaza\n\
\n\
<s>Drugie: Pieczona wołowina z ziemniakami</s>\n\
\n\
Drugie: Okrągły placek pomalowany na czerwono, z drewna i dziwnych liści (nowy przepis: polecany przez Trorków!!)\n\
\n\
Trzecie: Skarpeta, dobrze leżakowana i zapieczona w cieście</i>
items.Lore_Note_Goblin_Why_Purple.name = Dlaczego fioletowy?
items.Lore_Note_Goblin_Why_Purple.description = <i>Dlaczego niebo jest fioletowe?\n\
\n\
Podobno kiedyś było czerwone albo niebieskie.\n\
\n\
Niektóre rośliny też zaczynają robić się fioletowe. A trawa przestaje wyglądać jak trawa.\n\
\n\
Nie lubimy fioletu. Fiolet wydaje się niewłaściwy. Przynajmniej płomienie zmieniają go w czerń.\n\
\n\
Czerń jest znacznie lepsza.</i>
