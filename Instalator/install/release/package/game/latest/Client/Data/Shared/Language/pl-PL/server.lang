items.Ingredient_Hide_Dark.description = Można ją przetworzyć na <item is="Ingredient_Leather_Dark"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Hide_Heavy.name = Gruba skóra
items.Ingredient_Hide_Heavy.description = Można ją przetworzyć na <item is="Ingredient_Leather_Heavy"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Hide_Light.name = Lekka skóra
items.Ingredient_Hide_Light.description = Można ją przetworzyć na <item is="Ingredient_Leather_Light"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Hide_Medium.name = Średniej grubości skóra
items.Ingredient_Hide_Medium.description = Można ją przetworzyć na <item is="Ingredient_Leather_Medium"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Hide_Prismic.name = Pryzmatyczna skóra
items.Ingredient_Hide_Prismic.description = Można ją przetworzyć na <item is="Ingredient_Leather_Prismic"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Hide_Scaled.name = Łuskowata skóra
items.Ingredient_Hide_Scaled.description = Można ją przetworzyć na <item is="Ingredient_Leather_Scaled"/> w <item is="Bench_Tannery"/>.
items.Ingredient_Hide_Soft.name = Miękka skóra
items.Ingredient_Hide_Soft.description = Można ją przetworzyć na <item is="Ingredient_Leather_Soft"/> w <item is="Bench_Tannery"/>.
