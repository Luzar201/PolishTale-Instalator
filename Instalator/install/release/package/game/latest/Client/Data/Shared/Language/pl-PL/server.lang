items.Halloween_Wagon.name = Wóz na Halloween
items.Ingredient_Bar_Adamantite.name = Sztabka adamantytu
items.Ingredient_Bar_Adamantite.description = <item is="Ore_Adamantite"/> wymaga wysokiej jakości kilofa, aby ją rozbić.\n\n<i>Ten rzadki metal odegrał niegdyś kluczową rolę w rozwoju ludów Tygla. Choć z dawnej świetności miasta niewiele pozostało, ślady tej wytrzymałej rudy wciąż można znaleźć w głębinach pod spaloną ziemią.</i>
items.Ingredient_Bar_Bronze.name = Sztabka brązu
items.Ingredient_Bar_Cobalt.name = Sztabka kobaltu
items.Ingredient_Bar_Cobalt.description = <i>Według legend Wędrowców metal ten pozostaje zimny w dotyku nawet w stanie płynnym. Sprawdzanie tego byłoby nierozsądne, ale jego pochodzenie z mroźnych szczytów i zamarzniętych jaskiń ich ziem nadaje tej opowieści pewną wiarygodność.</i>
items.Ingredient_Bar_Copper.name = Sztabka miedzi
items.Ingredient_Bar_Copper.description = Powszechnie występujący metal wytapiany z rudy znajdowanej we wszystkich regionach Orbis.
items.Ingredient_Bar_Gold.name = Sztabka złota
items.Ingredient_Bar_Iron.name = Sztabka żelaza
items.Ingredient_Bar_Iron.description = Naturalna obfitość i niezawodna wytrzymałość czynią z niego idealny materiał do wytwarzania zwykłych narzędzi i broni.
items.Ingredient_Bar_Mithril.name = Sztabka mithrilu
items.Ingredient_Bar_Onyxium.name = Sztabka onyksium
items.Ingredient_Bar_Prisma.name = Sztabka pryzmy
items.Ingredient_Bar_Silver.name = Sztabka srebra
items.Ingredient_Bar_Thorium.name = Sztabka toru
items.Ingredient_Bar_Thorium.description = <i>Feranie sami nie korzystają z tego metalu, ale czujnie strzegą jego złóż na spieczonych słońcem pustyniach i suchych pustkowiach. Gdyby ich odwieczni wrogowie ponownie powstali, właśnie te zasoby jako pierwsze posłużyłyby im do wydobycia.</i>
items.Ingredient_Bolt_Cindercloth.name = Belka popiołotkaniny
items.Ingredient_Bolt_Cotton.name = Belka bawełny
items.Ingredient_Bolt_Linen.name = Belka lnu
items.Ingredient_Bolt_Prismaloom.name = Belka pryzmatycznej tkaniny
items.Ingredient_Bolt_Shadoweave.name = Belka cieniotkaniny
items.Ingredient_Bolt_Silk.name = Belka jedwabiu
items.Ingredient_Bolt_Stormsilk.name = Belka burzowego jedwabiu
items.Ingredient_Bolt_Wool.name = Belka wełny
items.Ingredient_Bone_Fragment.name = Fragmenty kości
items.Ingredient_Bone_Fragment.description = <i>Najbardziej rozwinięte cywilizacje Orbis łączyła wspólna cecha — pycha, która ostatecznie doprowadziła je do upadku. Te fragmenty kości oraz przeklęte stworzenie, z którego je pozyskano, powinny przypominać, że niektórych ścieżek lepiej nie przemierzać.</i>
items.Ingredient_Charcoal.name = Węgiel drzewny
items.Ingredient_Crystal_Blue.name = Niebieskie odłamki kryształu
items.Ingredient_Crystal_Cyan.name = Turkusowe odłamki kryształu
items.Ingredient_Crystal_Green.name = Zielone odłamki kryształu
items.Ingredient_Crystal_Pink.name = Różowe odłamki kryształu
items.Ingredient_Crystal_Purple.name = Fioletowe odłamki kryształu
items.Ingredient_Crystal_Red.name = Czerwone odłamki kryształu
items.Ingredient_Crystal_White.name = Białe odłamki kryształu
items.Ingredient_Crystal_Yellow.name = Żółte odłamki kryształu
items.Ingredient_Crystal_Void.name = Odłamki kryształu Pustki
items.Ingredient_Crystal_Void.description = <i>Pod Zasłoną skrywającą prawdziwe Orbis skoncentrowana Pustka wypacza nawet kryształowe struktury, zmieniając je w pokręcone imitacje życia. Choć odłamki zostały już rozbite, wciąż zachowują ślad tej energii.</i>
items.Ingredient_Fabric_Scrap_Cindercloth.name = Skrawki popiołotkaniny
items.Ingredient_Fabric_Scrap_Cindercloth.description = <i>Gdy przeklęty płomień spustoszył Tygiel, nie oszczędził niczego. Nawet te skrawki tkaniny, odzyskane ze zwęglonych kości dawnego mieszkańca, wciąż emanują niesamowitym ciepłem.</i>
items.Ingredient_Fabric_Scrap_Cotton.name = Skrawki bawełny
items.Ingredient_Fabric_Scrap_Linen.name = Skrawki lnu
items.Ingredient_Fabric_Scrap_Linen.description = Skrawki pospolitej tkaniny, z której wiele gatunków Orbis szyje swoje ubrania.
items.Ingredient_Fabric_Scrap_Prismaloom.name = Skrawki pryzmatycznej tkaniny
items.Ingredient_Fabric_Scrap_Shadoweave.name = Skrawki cieniotkaniny
items.Ingredient_Fabric_Scrap_Shadoweave.description = <i>Ta ciężka tkanina, przesycona cichą, posępną ciemnością, została opracowana przez Wędrowców przed ich pierwszym kontaktem z Pustką. Choć nadal stanowi podstawowy element ich ubioru, sekret jej wytwarzania dawno już zaginął.</i>
items.Ingredient_Fabric_Scrap_Silk.name = Skrawki jedwabiu
items.Ingredient_Fabric_Scrap_Stormsilk.name = Skrawki burzowego jedwabiu
items.Ingredient_Spider_Silk.name = Pajęczy jedwab
items.Ingredient_Enkindled_Resource.name = Rozpalony sygnet
items.Ingredient_Enkindled_Resource.description = <i>Ten sygnet opowiada o cywilizacji utraconej wskutek kataklizmu, który pozostawił blizny na Orbis. Najtwardsze z nieumarłych Strażników Widm trzymają go blisko miejsca, w którym niegdyś znajdowały się ich serca.</i>
items.Ingredient_Deep_Resource.name = Związany skarb
items.Ingredient_Deep_Resource.description = <i>Niewielu goblinów rozumie przeznaczenie tych błyszczących przedmiotów. Nawet Mistrzowie Uczt traktują je czasem jedynie jako ozdoby.</i>
items.Ingredient_Voidtaken_Grizzly_Hide.name = Skóra grizzly skażonego Pustką
items.Ingredient_Voidtaken_Grizzly_Hide.description = <i>Ta skóra skażona Pustką nosi ślady niezliczonych walk, zarówno sprzed skażenia, jak i po nim. Tam, gdzie Zasłona Pustki jest najgęstsza, te bestie często przemierzają okolicę.</i>
items.Ingredient_Gadget_Assembly.name = Podejrzany mechanizm
items.Ingredient_Gadget_Assembly.description = <i>Czy to w ogóle działa? Prawdopodobnie dałoby się zbudować coś podobnego na podstawie prostej goblińskiej konstrukcji, ale trudno zgadnąć, do czego właściwie ma służyć.</i>
items.Ingredient_Gobliterator_Core.name = Rdzeń Gobliteratora
items.Ingredient_Gobliterator_Core.description = <i>Sama maszyna byłaby zbyt ciężka, by ją zabrać, ale ten tajemniczy mechaniczny rdzeń stanowi doskonałe trofeum.</i>
items.Ingredient_Rune_Shard.name = Odłamek runicznego kamienia
items.Ingredient_Rune_Shard.description = Służy do wytwarzania Kamieni Runicznych przy użyciu <item is="GoblinLab_Tinkering_Bench"/>.\n\
\n\
<i>Niektóre z tych odłamków mogą pochodzić z czasów dawno wymarłych Wiązaczy Run, jednak większość powstała, gdy potężna magia odcisnęła swoje piętno na zwykłym kamieniu znajdującym się w posiadaniu możnych.</i>
items.Ingredient_Fabric_Scrap_Wool.name = Skrawki wełny
items.Ingredient_Feathers_Blue.name = Niebieskie pióra
items.Ingredient_Feathers_Dark.name = Ciemne pióra
