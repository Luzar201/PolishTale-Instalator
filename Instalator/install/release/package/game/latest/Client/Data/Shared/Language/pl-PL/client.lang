builderTools.legend.MachinimaTool.Page7.OffsetToOrigin = Przesuń całą scenę do pozycji gracza
builderTools.legend.MachinimaTool.Page8.Title = Ścieżki i krzywe
builderTools.legend.MachinimaTool.Page8.Description = Wybierz sposób interpolacji między klatkami kluczowymi:
builderTools.legend.MachinimaTool.Page8.LinearHeader = Liniowa (domyślna)
builderTools.legend.MachinimaTool.Page8.LinearDesc = Proste linie między klatkami kluczowymi. Prosty i przewidywalny ruch.
builderTools.legend.MachinimaTool.Page8.BezierHeader = Krzywa Béziera
builderTools.legend.MachinimaTool.Page8.BezierDesc = Gładkie krzywe z uchwytami sterującymi, które można przeciągać, aby kształtować ścieżkę.
builderTools.legend.MachinimaTool.Page8.SplineHeader = Splajn
builderTools.legend.MachinimaTool.Page8.SplineDesc = Automatycznie wygładzane krzywe przechodzące przez wszystkie klatki kluczowe.
builderTools.legend.MachinimaTool.Page8.BezierCommands = Polecenia ścieżki:
builderTools.legend.MachinimaTool.Page8.EnableBezier = Włącz krzywą Béziera
builderTools.legend.MachinimaTool.Page8.SmoothBezier = Wygładź uchwyty
builderTools.legend.MachinimaTool.Page8.EnableSpline = Włącz splajn
builderTools.legend.MachinimaTool.Page9.Title = Polecenia konsoli
builderTools.legend.MachinimaTool.Page9.SceneCommands = Scena: .mach scene [load | copy | rename]
builderTools.legend.MachinimaTool.Page9.ActorCommands = Aktor: .mach actor [list | add | remove | set | model | move | clone | rotate | scale | clear]
builderTools.legend.MachinimaTool.Page9.EventCommands = Zdarzenia: .mach event [list | add | remove]\n\
Typy zdarzeń: animation, camera, command, particle, target
builderTools.legend.MachinimaTool.Page9.FileCommands = Pliki: .mach save | load | files | autosave [seconds]
builderTools.legend.MachinimaTool.Page9.UtilityCommands = Narzędzia: .mach tool | speed [value] | align | restart
builderTools.legend.PasteTool.Page1.Title = Pędzel wklejania prefabrykatów
